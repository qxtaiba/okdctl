{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    ":disableRateLimiting",
    "github>qxtaiba/okdctl//.github/renovate/autoMerge.json5",
    "github>qxtaiba/okdctl//.github/renovate/labels.json5",
    "github>qxtaiba/okdctl//.github/renovate/groups.json5",
    "github>qxtaiba/okdctl//.github/renovate/semanticCommits.json5",
    "github>qxtaiba/okdctl//.github/renovate/customManagers.json5"
  ],
  "dependencyDashboard": { "title": "Renovate Dashboard 🤖" },
  "commitMessageLowerCase": "auto",
  "timezone": "UTC",
  "suppressNotifications": [
    "prEditedNotification",
    "prIgnoreNotification"
  ],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      // sigs.k8s.io/yaml wraps go.yaml.in/yaml/v2; a v4 loader would be a third
      // YAML engine against the two-engine baseline (CLAUDE.md, dependencies).
      "matchPackageNames": ["go.yaml.in/yaml/v2"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
