{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    ":disableRateLimiting",
    "github>qxtaiba/okdctl//.github/renovate/autoMerge.json5",
    "github>qxtaiba/okdctl//.github/renovate/labels.json5",
    "github>qxtaiba/okdctl//.github/renovate/groups.json5",
    "github>qxtaiba/okdctl//.github/renovate/semanticCommits.json5",
    "github>qxtaiba/okdctl//.github/renovate/customManagers.json5"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "commitMessageLowerCase": "always",
  "timezone": "UTC",
  "suppressNotifications": [
    "prEditedNotification",
    "prIgnoreNotification"
  ],
  "terraform": {
    "managerFilePatterns": [
      "/infrastructure/terraform/.+\\.tf$/"
    ]
  },
  "packageRules": [
    {
      "description": "ci-testgo-xcrypto-053-runner-death — x/crypto v0.53.0 OOM-kills the ubuntu CI runner; block only that version so the first v0.54.0+ PR doubles as the CI canary",
      "matchPackageNames": ["golang.org/x/crypto"],
      "allowedVersions": "!/^v0\\.53\\.0$/"
    }
  ]
}
