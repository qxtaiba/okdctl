{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    ":disableRateLimiting",
    "github>qxtaiba/okd-proxmox-cli//.github/renovate/autoMerge.json5",
    "github>qxtaiba/okd-proxmox-cli//.github/renovate/labels.json5",
    "github>qxtaiba/okd-proxmox-cli//.github/renovate/groups.json5",
    "github>qxtaiba/okd-proxmox-cli//.github/renovate/semanticCommits.json5",
    "github>qxtaiba/okd-proxmox-cli//.github/renovate/customManagers.json5"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "commitMessageLowerCase": "always",
  "timezone": "UTC",
  "suppressNotifications": [
    "prEditedNotification",
    "prIgnoreNotification"
  ],
  "terraform": {
    "managerFilePatterns": [
      "/infrastructure/terraform/.+\\.tf$/"
    ]
  }
}
