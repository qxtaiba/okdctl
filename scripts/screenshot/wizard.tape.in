# Template for scripts/screenshot/run.sh: renders the full 11-step wizard
# walkthrough against the fakepve fixture and screenshots the header of
# every step. @W@/@H@/@NAME@ are substituted per size preset by run.sh.
# Each "STEP N" block is self-contained: the wait/screenshot pair that opens
# it, then the keystrokes that complete that step and advance to the next
# one. Keystroke sequences mirror docs/assets/demo.tape (the human-paced
# README recording) with sleeps compressed for unattended batch rendering.
Output out/@NAME@.txt
Set Shell zsh
Set FontSize 14
Set Padding 0
Set LineHeight 1.0
Set LetterSpacing 1.0
Set Width @W@
Set Height @H@

Hide
Type `export PATH="$(dirname "$OKDCTL_DEMO_BIN"):$PATH" HOME="$OKDCTL_DEMO_HOME" OKDCTL_WIZARD_DEMO=1; cd "$OKDCTL_DEMO_CWD"; clear`
Enter
Show

Type "okdctl deploy"
Sleep 450ms
Enter

# ==================== STEP 1: welcome ====================
Wait+Screen@10s /step 1 of 11/
Screenshot out/@NAME@-welcome.png
Enter
Sleep 450ms

# ==================== STEP 2: okd version (distribution) ====================
Wait+Screen@10s /step 2 of 11/
Screenshot out/@NAME@-distribution.png
Enter
Sleep 650ms
Down
Sleep 450ms
Down
Sleep 450ms
Up
Sleep 450ms
Up
Sleep 650ms
Enter
Sleep 450ms

